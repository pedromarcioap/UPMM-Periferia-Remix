# ===========================================
# UPMM Platform - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# These variables are required for the application to work

# ===========================================
# DATABASE (Supabase PostgreSQL)
# ===========================================
# Connection pooler URL (for serverless/Vercel)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection URL (for migrations)
DIRECT_DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ===========================================
# NEXTAUTH.JS (Authentication)
# ===========================================
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here"

# Your production URL
NEXTAUTH_URL="https://your-domain.vercel.app"

# ===========================================
# GOOGLE OAUTH (Optional)
# ===========================================
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ===========================================
# SUPABASE STORAGE (Optional - for file uploads)
# ===========================================
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_KEY=""

# ===========================================
# PEXELS API (For seed images)
# ===========================================
PEXELS_API_KEY=""
