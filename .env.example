# =============================================
# SUPABASE DATABASE CONFIGURATION
# =============================================
# Para obter as URLs de conexão:
# 1. Acesse: https://supabase.com/dashboard/project/YOUR_PROJECT_ID/settings/database
# 2. Copie a "Connection string" (URI)
# 3. Substitua [YOUR-PASSWORD] pela senha do banco
#
# IMPORTANTE: Use duas conexões diferentes:
# - DATABASE_URL: Pooler (porta 6543) - para serverless/Vercel
# - DIRECT_DATABASE_URL: Direct (porta 5432) - para migrations

# Connection Pooler (para serverless - Vercel, Cloudflare, etc)
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection (para migrations e Prisma Studio)
DIRECT_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# =============================================
# OUTRAS CONFIGURAÇÕES
# =============================================

# Pexels API (obtenha em: https://www.pexels.com/api/)
PEXELS_API_KEY=

# NextAuth.js
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
