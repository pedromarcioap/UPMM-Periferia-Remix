// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum NotificationType {
  REMIX_CREATED
  GOLD_STANDARD
  BATTLE_WIN
  NEW_FOLLOWER
  BADGE_EARNED
}

model User {
  id             String        @id @default(uuid()) @db.Uuid
  email          String        @unique
  name           String?
  username       String?       @unique
  bio            String?
  avatar         String?
  googleId       String?       @unique
  password       String?
  vibePoints     Int           @default(0)
  responsaPoints Int           @default(0)
  level          Int           @default(1)
  role           Role          @default(USER)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  photos         Photo[]
  remixes        Remix[]
  comments       Comment[]
  likes          Like[]
  badges         UserBadge[]
  notifications  Notification[]
  battleVotes    BattleVote[]
  accounts       Account[]
  sessions       Session[]
}

model Photo {
  id              String         @id @default(uuid()) @db.Uuid
  title           String
  description     String?
  imageUrl        String
  thumbnailUrl    String?
  tags            String
  authorId        String         @db.Uuid
  vibeCount       Int            @default(0)
  commentCount    Int            @default(0)
  remixCount      Int            @default(0)
  isGoldStandard  Boolean        @default(false)
  communityGold   Boolean        @default(false)
  isSynced        Boolean        @default(false)
  syncedAt        DateTime?
  latitude        Float?
  longitude       Float?
  location        String?
  neighborhood    String?
  city            String?        @default("Palmas")
  state           String?        @default("Tocantins")
  country         String?        @default("Brasil")
  battleWins      Int            @default(0)
  battleLosses    Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  author          User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  remixes         Remix[]
  comments        Comment[]
  likes           Like[]
  battleVotesAsPhoto1 BattleVote[] @relation("Photo1Votes")
  battleVotesAsPhoto2 BattleVote[] @relation("Photo2Votes")
}

model Remix {
  id              String     @id @default(uuid()) @db.Uuid
  title           String?
  imageUrl        String
  originalPhotoId String     @db.Uuid
  creatorId       String     @db.Uuid
  parentRemixId   String?    @db.Uuid
  vibeCount       Int        @default(0)
  commentCount    Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  originalPhoto   Photo      @relation(fields: [originalPhotoId], references: [id], onDelete: Cascade)
  creator         User       @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  comments        Comment[]
  likes           Like[]
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  content   String
  userId    String   @db.Uuid
  photoId   String?  @db.Uuid
  remixId   String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo     Photo?   @relation(fields: [photoId], references: [id], onDelete: Cascade)
  remix     Remix?   @relation(fields: [remixId], references: [id], onDelete: Cascade)
}

model Like {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  photoId   String?  @db.Uuid
  remixId   String?  @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo     Photo?   @relation(fields: [photoId], references: [id], onDelete: Cascade)
  remix     Remix?   @relation(fields: [remixId], references: [id], onDelete: Cascade)
}

model Badge {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @unique
  description String
  icon        String
  type        String
  requirement String
  users       UserBadge[]
}

model UserBadge {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @db.Uuid
  badgeId  String   @db.Uuid
  earnedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge    Badge    @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  type        NotificationType
  title       String
  message     String
  data        String?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BattleVote {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  photo1Id    String   @db.Uuid
  photo2Id    String   @db.Uuid
  winnerId    String   @db.Uuid
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo1      Photo    @relation("Photo1Votes", fields: [photo1Id], references: [id], onDelete: Cascade)
  photo2      Photo    @relation("Photo2Votes", fields: [photo2Id], references: [id], onDelete: Cascade)

  @@unique([userId, photo1Id, photo2Id])
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
